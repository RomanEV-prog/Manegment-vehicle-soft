# Database
DATABASE_URL=postgresql+asyncpg://eversum:secret@db:5432/eversum_db
DATABASE_URL_SYNC=postgresql://eversum:secret@db:5432/eversum_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eversum-vehicle-docs
MINIO_USE_SSL=false

# MinIO root credentials (produkcija — docker-compose.prod.yml)
# Generiraj: openssl rand -hex 16
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_in_prod

# PostgreSQL password (produkcija)
# Generiraj: openssl rand -hex 16
DB_PASSWORD=change_in_prod

# Frontend build URLs (produkcija)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email (alarmi)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-key
EMAIL_FROM=noreply@eversum.com

# SMS (Twilio - opcijsko)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# FCM push notifikacije
# Pridobi iz Firebase Console → Project Settings → Service Accounts → Generate new private key
# Prilepi celoten JSON kot eno vrstico (escaped), npr.:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"eversum-...","private_key_id":"..."}
FIREBASE_CREDENTIALS_JSON=

# Environment
ENVIRONMENT=development
DEBUG=true
